# ---------------------------------------------------------------------------
# Copy to .env and fill in.  Day 1 only needs LOG_LEVEL and IMAGE_OUTPUT_DIR.
# The rest are placeholders for later days so you only edit one file.
# ---------------------------------------------------------------------------

# --- Day 1: logging & paths ---
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# pretty-print logs in dev (true) vs raw JSON (false)
LOG_PRETTY=true
# where captured images are written (Day 4); Day 1 stub reads a fixture instead
IMAGE_OUTPUT_DIR=./output

# --- Day 1: validation thresholds (used by real checks on Day 5) ---
MIN_IMAGE_BYTES=20000
BLANK_STDDEV_FLOOR=4

# --- Day 2: Discord (leave blank on Day 1) ---
DISCORD_BOT_TOKEN=

# --- Day 3: Playwright / TradingView session (leave defaults on Day 1) ---
PW_USER_DATA_DIR=./.pw-profile
HEADLESS=false